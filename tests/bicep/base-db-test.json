      "tags": "[variables('ownership')]",
      "properties": {
        "source": "None",
        "resourceAnchorId": "[parameters('resourceAnchorId')]",
        "networkAnchorId": "[parameters('networkAnchorId')]",
        "hostname": "basetest00",
        "displayName": "basetest00",
        "shape": "[parameters('shape')]",
        "dbVersion": "[parameters('dbVersion')]",
        "databaseEdition": "EnterpriseEdition",
        "licenseModel": "LicenseIncluded",
        "nodeCount": 1,
        "computeModel": "[parameters('computeModel')]",
        "computeCount": "[parameters('computeCount')]",
        "initialDataStorageSizeInGb": "[parameters('storageSizeGb')]",
        "dbSystemOptions": {
          "storageManagement": "LVM"
        },
        "pdbName": "WORKSHOP",
        "sshPublicKeys": [
          "[parameters('sshPublicKey')]"
        ],
        "adminPassword": "[parameters('adminPassword')]"
      }
    }
  ]
