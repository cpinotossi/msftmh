# ===============================================================================
# Packer Variables - Oracle Workshop Image
# ===============================================================================
# Copy this file to variables.auto.pkrvars.hcl and fill in your values
# ===============================================================================

# Azure Authentication
# CI: uses azure/login OIDC on a GitHub-hosted runner.
# Local: uses az login (your user) via use_azure_cli_auth=true
subscription_id = "aca3d6b0-497a-40cc-bdd0-e8e3ef6d8483"

# Location - should match your Compute Gallery location
location = "francecentral"

# Resource Group containing the Compute Gallery
resource_group = "rg-workshop-images"

# Separate Resource Group used for temporary Packer build resources (pkr*)
build_resource_group = "rg-packer-build"

# Azure Compute Gallery settings
gallery_name = "gal_oracle_workshop"
image_name   = "oracle-workshop-vm"

# Image version (increment for each new build)
image_version = "1.1.0"

# Fixed x64/Gen2 NVMe build size in France Central.
vm_size = "Standard_D4as_v7"
