# ===============================================================================
# Packer Variables File
# ===============================================================================
# Copy this file to variables.pkrvars.hcl and fill in your values.
#
# Usage:
#   packer build -var-file=variables.pkrvars.hcl oracle-workshop.pkr.hcl
# ===============================================================================

# Azure Authentication (Service Principal)
tenant_id     = "<your-tenant-id>"
client_id     = "<your-client-id>"
client_secret = "<your-client-secret>"

# Azure Subscription
subscription_id = "<your-subscription-id>"

# Location
location = "francecentral"

# Compute Gallery
gallery_name           = "gal_oracle_workshop"
gallery_resource_group = "rg-shared-workshop"
image_name             = "oracle-workshop-vm"
image_version          = "1.0.0"

# Build Configuration
resource_group = "rg-packer-build"
vm_size        = "Standard_D2s_v5"
